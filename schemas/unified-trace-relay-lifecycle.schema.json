{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/unified-trace-relay-lifecycle.schema.json",
  "title": "Unified Trace Relay Lifecycle",
  "description": "A unified lifecycle record for tracking a conceptual trace from dialogue origin through relay, handoff, routing, transformation, mutation audit, re-ignition, royalty bridge, structural audit, human approval, and next-cycle continuation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lifecycle_id",
    "title",
    "created_at",
    "status",
    "lifecycle_purpose",
    "origin_summary",
    "layer_refs",
    "phase_sequence",
    "current_state",
    "completion_criteria",
    "continuity_controls",
    "next_cycle",
    "governance",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "lifecycle_id": {
      "type": "string",
      "pattern": "^utrl-[A-Za-z0-9._-]+$",
      "description": "Unique identifier for the unified trace relay lifecycle record."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed",
        "completed_with_conditions",
        "blocked",
        "archived"
      ]
    },
    "lifecycle_purpose": {
      "type": "string",
      "minLength": 1
    },
    "origin_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_type",
        "origin_trace_id",
        "origin_title",
        "origin_description"
      ],
      "properties": {
        "origin_type": {
          "type": "string",
          "enum": [
            "dialogue",
            "document",
            "repository",
            "schema",
            "article",
            "book",
            "gpt",
            "external_system"
          ]
        },
        "origin_trace_id": {
          "type": "string",
          "pattern": "^trace-[A-Za-z0-9._-]+$"
        },
        "origin_title": {
          "type": "string",
          "minLength": 1
        },
        "origin_description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layer_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_relay_record",
        "trace_handoff_record",
        "multi_wing_trace_route",
        "trace_transformation_rule",
        "trace_diff_mutation_log",
        "trace_re_ignition_record",
        "trace_royalty_bridge",
        "structural_audit_bridge",
        "human_gate_approval_receipt"
      ],
      "properties": {
        "trace_relay_record": {
          "type": "string",
          "pattern": "^trr-[A-Za-z0-9._-]+$"
        },
        "trace_handoff_record": {
          "type": "string",
          "pattern": "^th-[A-Za-z0-9._-]+$"
        },
        "multi_wing_trace_route": {
          "type": "string",
          "pattern": "^mwtr-[A-Za-z0-9._-]+$"
        },
        "trace_transformation_rule": {
          "type": "string",
          "pattern": "^ttr-[A-Za-z0-9._-]+$"
        },
        "trace_diff_mutation_log": {
          "type": "string",
          "pattern": "^tdm-[A-Za-z0-9._-]+$"
        },
        "trace_re_ignition_record": {
          "type": "string",
          "pattern": "^ri-[A-Za-z0-9._-]+$"
        },
        "trace_royalty_bridge": {
          "type": "string",
          "pattern": "^trb-[A-Za-z0-9._-]+$"
        },
        "structural_audit_bridge": {
          "type": "string",
          "pattern": "^sab-[A-Za-z0-9._-]+$"
        },
        "human_gate_approval_receipt": {
          "type": "string",
          "pattern": "^hgar-[A-Za-z0-9._-]+$"
        }
      }
    },
    "phase_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase_id",
          "phase_name",
          "phase_status",
          "record_ref",
          "summary"
        ],
        "properties": {
          "phase_id": {
            "type": "string",
            "pattern": "^phase-[A-Za-z0-9._-]+$"
          },
          "phase_name": {
            "type": "string",
            "enum": [
              "record",
              "handoff",
              "route",
              "transform",
              "diff",
              "re_ignition",
              "royalty_bridge",
              "structural_audit",
              "human_gate",
              "next_cycle"
            ]
          },
          "phase_status": {
            "type": "string",
            "enum": [
              "not_started",
              "active",
              "completed",
              "completed_with_notes",
              "blocked",
              "skipped"
            ]
          },
          "record_ref": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_phase",
        "lifecycle_status",
        "last_completed_phase",
        "open_conditions",
        "blocked_claims"
      ],
      "properties": {
        "current_phase": {
          "type": "string",
          "enum": [
            "record",
            "handoff",
            "route",
            "transform",
            "diff",
            "re_ignition",
            "royalty_bridge",
            "structural_audit",
            "human_gate",
            "next_cycle",
            "completed"
          ]
        },
        "lifecycle_status": {
          "type": "string",
          "enum": [
            "active",
            "completed",
            "completed_with_conditions",
            "blocked",
            "archived"
          ]
        },
        "last_completed_phase": {
          "type": "string",
          "enum": [
            "record",
            "handoff",
            "route",
            "transform",
            "diff",
            "re_ignition",
            "royalty_bridge",
            "structural_audit",
            "human_gate",
            "none"
          ]
        },
        "open_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "completion_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_completed_phases",
        "required_audit_results",
        "required_human_gate_status",
        "completion_result"
      ],
      "properties": {
        "required_completed_phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "record",
              "handoff",
              "route",
              "transform",
              "diff",
              "re_ignition",
              "royalty_bridge",
              "structural_audit",
              "human_gate"
            ]
          }
        },
        "required_audit_results": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pass",
              "pass_with_notes",
              "conditional",
              "pending",
              "fail"
            ]
          }
        },
        "required_human_gate_status": {
          "type": "string",
          "enum": [
            "approved",
            "conditional",
            "rejected",
            "pending",
            "not_required"
          ]
        },
        "completion_result": {
          "type": "string",
          "enum": [
            "complete",
            "complete_with_conditions",
            "incomplete",
            "blocked"
          ]
        }
      }
    },
    "continuity_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_preserve",
        "must_not_claim",
        "must_carry_forward"
      ],
      "properties": {
        "must_preserve": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_not_claim": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_carry_forward": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next_cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_cycle_allowed",
        "next_cycle_type",
        "next_cycle_trigger",
        "recommended_next_record",
        "conditions"
      ],
      "properties": {
        "next_cycle_allowed": {
          "type": "boolean"
        },
        "next_cycle_type": {
          "type": "string",
          "enum": [
            "none",
            "new_trace_relay",
            "derivative_output_record",
            "publication_receipt",
            "manual_royalty_review",
            "external_handoff",
            "archive"
          ]
        },
        "next_cycle_trigger": {
          "type": "string",
          "minLength": 1
        },
        "recommended_next_record": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_authority_required",
        "ai_role",
        "approval_boundary",
        "governance_notes"
      ],
      "properties": {
        "human_authority_required": {
          "type": "boolean"
        },
        "ai_role": {
          "type": "string",
          "enum": [
            "reflection_support",
            "structuring_support",
            "audit_support",
            "routing_support",
            "none"
          ]
        },
        "approval_boundary": {
          "type": "string",
          "minLength": 1
        },
        "governance_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_valid",
        "audit_result",
        "human_review_completed",
        "boundary_notes"
      ],
      "properties": {
        "lifecycle_valid": {
          "type": "boolean"
        },
        "audit_result": {
          "type": "string",
          "enum": [
            "pass",
            "pass_with_notes",
            "fail",
            "pending"
          ]
        },
        "human_review_completed": {
          "type": "boolean"
        },
        "boundary_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
