{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/trace-handoff-record.schema.json",
  "title": "Trace Handoff Record",
  "description": "A record for handing conceptual traces from one dialogue, memory layer, AI wing, or derivative structure to another.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "title",
    "created_at",
    "status",
    "source_trace",
    "handoff_source",
    "handoff_target",
    "handoff_payload",
    "route",
    "continuity",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^th-[A-Za-z0-9._-]+$",
      "description": "Unique identifier for the trace handoff record."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["active", "completed", "blocked", "archived"]
    },
    "source_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "title",
        "summary",
        "source_relay_id"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^trace-[A-Za-z0-9._-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_relay_id": {
          "type": "string",
          "pattern": "^trr-[A-Za-z0-9._-]+$"
        }
      }
    },
    "handoff_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_name",
        "source_context"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["human", "ai", "wing", "memory_layer", "audit_layer", "system"]
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_context": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "handoff_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_type",
        "target_name",
        "target_purpose"
      ],
      "properties": {
        "target_type": {
          "type": "string",
          "enum": [
            "dialogue",
            "wing",
            "repository",
            "document",
            "memory_layer",
            "audit_layer",
            "derivative_structure",
            "external_system"
          ]
        },
        "target_name": {
          "type": "string",
          "minLength": 1
        },
        "target_purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "handoff_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserved_trace_elements",
        "transformation_intent",
        "boundary_conditions"
      ],
      "properties": {
        "preserved_trace_elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transformation_intent": {
          "type": "string",
          "minLength": 1
        },
        "boundary_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_mode",
        "next_actions",
        "blocking_conditions"
      ],
      "properties": {
        "handoff_mode": {
          "type": "string",
          "enum": ["direct", "review_required", "multi_step", "deferred"]
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocking_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_refs",
        "expected_continuation",
        "continuity_risk"
      ],
      "properties": {
        "lineage_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_continuation": {
          "type": "string",
          "minLength": 1
        },
        "continuity_risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_review_required",
        "authorship_notes",
        "boundary_notes"
      ],
      "properties": {
        "human_review_required": {
          "type": "boolean"
        },
        "authorship_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundary_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
