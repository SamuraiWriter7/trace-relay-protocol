{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/trace-diff-mutation-log.schema.json",
  "title": "Trace Diff Mutation Log",
  "description": "A log for recording how a conceptual trace changed during transformation, including preserved elements, additions, removals, semantic drift, authorship boundaries, and review status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mutation_log_id",
    "title",
    "created_at",
    "status",
    "source_trace",
    "source_rule",
    "mutation_context",
    "before_state",
    "after_state",
    "diff_summary",
    "mutation_events",
    "preservation_check",
    "risk_delta",
    "approval",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.5.0"
    },
    "mutation_log_id": {
      "type": "string",
      "pattern": "^tdm-[A-Za-z0-9._-]+$",
      "description": "Unique identifier for the trace diff / mutation log."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "approved", "rejected", "archived"]
    },
    "source_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "title",
        "summary",
        "source_handoff_id",
        "source_route_id"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^trace-[A-Za-z0-9._-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_handoff_id": {
          "type": "string",
          "pattern": "^th-[A-Za-z0-9._-]+$"
        },
        "source_route_id": {
          "type": "string",
          "pattern": "^mwtr-[A-Za-z0-9._-]+$"
        }
      }
    },
    "source_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "rule_title",
        "max_transformation_level"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^ttr-[A-Za-z0-9._-]+$"
        },
        "rule_title": {
          "type": "string",
          "minLength": 1
        },
        "max_transformation_level": {
          "type": "string",
          "enum": ["format_only", "minor", "moderate", "major"]
        }
      }
    },
    "mutation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_type",
        "performed_by",
        "purpose",
        "target_output"
      ],
      "properties": {
        "mutation_type": {
          "type": "string",
          "enum": [
            "summarization",
            "compression",
            "expansion",
            "translation",
            "technical_formalization",
            "symbolic_reframing",
            "audit_reframing",
            "derivative_preparation",
            "publication_edit"
          ]
        },
        "performed_by": {
          "type": "string",
          "enum": ["human", "ai", "human_ai_collaboration", "wing_route"]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "target_output": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "before_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_claims",
        "preserved_terms",
        "boundary_notes"
      ],
      "properties": {
        "core_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preserved_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundary_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "after_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_claims",
        "preserved_terms",
        "new_terms",
        "boundary_notes"
      ],
      "properties": {
        "core_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preserved_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "new_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundary_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diff_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserved",
        "added",
        "removed",
        "modified",
        "semantic_drift_level"
      ],
      "properties": {
        "preserved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semantic_drift_level": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        }
      }
    },
    "mutation_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "operation",
          "description",
          "impact_level",
          "rule_compliance"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^event-[A-Za-z0-9._-]+$"
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "impact_level": {
            "type": "string",
            "enum": ["format_only", "minor", "moderate", "major"]
          },
          "rule_compliance": {
            "type": "string",
            "enum": ["compliant", "needs_review", "non_compliant"]
          }
        }
      }
    },
    "preservation_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_preserved",
        "authorship_boundary_preserved",
        "symbolic_factual_distinction_preserved",
        "human_review_requirement_preserved",
        "missing_elements"
      ],
      "properties": {
        "lineage_preserved": {
          "type": "boolean"
        },
        "authorship_boundary_preserved": {
          "type": "boolean"
        },
        "symbolic_factual_distinction_preserved": {
          "type": "boolean"
        },
        "human_review_requirement_preserved": {
          "type": "boolean"
        },
        "missing_elements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risk_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_drift_change",
        "authorship_risk_change",
        "mythic_overextension_change",
        "overall_risk_after_mutation",
        "risk_notes"
      ],
      "properties": {
        "semantic_drift_change": {
          "type": "string",
          "enum": ["decreased", "unchanged", "increased"]
        },
        "authorship_risk_change": {
          "type": "string",
          "enum": ["decreased", "unchanged", "increased"]
        },
        "mythic_overextension_change": {
          "type": "string",
          "enum": ["decreased", "unchanged", "increased"]
        },
        "overall_risk_after_mutation": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_review_required",
        "human_review_status",
        "approved_for_next_handoff"
      ],
      "properties": {
        "human_review_required": {
          "type": "boolean"
        },
        "human_review_status": {
          "type": "string",
          "enum": ["not_required", "pending", "approved", "rejected"]
        },
        "approved_for_next_handoff": {
          "type": "boolean"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_required",
        "audit_result",
        "boundary_notes"
      ],
      "properties": {
        "audit_required": {
          "type": "boolean"
        },
        "audit_result": {
          "type": "string",
          "enum": ["pass", "pass_with_notes", "fail", "pending"]
        },
        "boundary_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
