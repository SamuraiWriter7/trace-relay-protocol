{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/trace-transformation-rule.schema.json",
  "title": "Trace Transformation Rule",
  "description": "A rule definition for controlling how conceptual traces may be transformed while preserving lineage, authorship boundaries, semantic integrity, and human review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "title",
    "created_at",
    "status",
    "applies_to",
    "source_route",
    "transformation_scope",
    "allowed_transformations",
    "prohibited_transformations",
    "preservation_requirements",
    "mutation_controls",
    "risk_assessment",
    "output_requirements",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.4.0"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^ttr-[A-Za-z0-9._-]+$",
      "description": "Unique identifier for the trace transformation rule."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "archived"]
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_types",
        "wing_ids",
        "route_ids"
      ],
      "properties": {
        "trace_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "conceptual_seed",
              "dialogue_trace",
              "memory_seed",
              "audit_trace",
              "derivative_trace",
              "symbolic_trace",
              "technical_trace"
            ]
          }
        },
        "wing_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^wing-[A-Za-z0-9._-]+$"
          }
        },
        "route_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^mwtr-[A-Za-z0-9._-]+$"
          }
        }
      }
    },
    "source_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "source_trace_id",
        "source_handoff_id",
        "summary"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^mwtr-[A-Za-z0-9._-]+$"
        },
        "source_trace_id": {
          "type": "string",
          "pattern": "^trace-[A-Za-z0-9._-]+$"
        },
        "source_handoff_id": {
          "type": "string",
          "pattern": "^th-[A-Za-z0-9._-]+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transformation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_type",
        "purpose",
        "semantic_drift_tolerance"
      ],
      "properties": {
        "scope_type": {
          "type": "string",
          "enum": [
            "summarization",
            "compression",
            "expansion",
            "translation",
            "technical_formalization",
            "symbolic_reframing",
            "audit_reframing",
            "derivative_preparation"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "semantic_drift_tolerance": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        }
      }
    },
    "allowed_transformations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "description",
          "conditions"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "prohibited_transformations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "reason"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preservation_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_preserve",
        "must_label",
        "must_not_remove"
      ],
      "properties": {
        "must_preserve": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_label": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_not_remove": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mutation_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_transformation_level",
        "requires_diff_summary",
        "requires_human_review"
      ],
      "properties": {
        "max_transformation_level": {
          "type": "string",
          "enum": ["format_only", "minor", "moderate", "major"]
        },
        "requires_diff_summary": {
          "type": "boolean"
        },
        "requires_human_review": {
          "type": "boolean"
        }
      }
    },
    "risk_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_drift_risk",
        "authorship_risk",
        "mythic_overextension_risk",
        "risk_notes"
      ],
      "properties": {
        "semantic_drift_risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "authorship_risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "mythic_overextension_risk": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_outputs",
        "forbidden_outputs"
      ],
      "properties": {
        "required_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_required",
        "human_review_required",
        "boundary_notes"
      ],
      "properties": {
        "audit_required": {
          "type": "boolean"
        },
        "human_review_required": {
          "type": "boolean"
        },
        "boundary_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
